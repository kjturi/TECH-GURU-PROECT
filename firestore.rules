rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles: users/{uid}
    match /users/{userId} {
      // Anyone signed in can see a doc if it's their own, if they're an
      // admin, OR if the doc itself is an admin's — that last clause is
      // what lets the Asset Request Form list admins to pick as Level 1 /
      // Level 2 approvers, without exposing every requester's profile to
      // every other signed-in user.
      allow read: if isSignedIn() && (
        request.auth.uid == userId || isAdmin() || resource.data.role == 'admin'
      );

      // Registration: a user may only create THEIR OWN profile document,
      // and it must be created with role "requester". This — not anything
      // in the UI — is the real enforcement behind "a normal user must
      // never be able to assign themselves the admin role": even a
      // hand-crafted request straight to Firestore is rejected if it tries
      // role: "admin" on create.
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'requester';

      // A user can update their own profile, but not their own role —
      // changing role requires isAdmin() (User Management promotes/demotes
      // other accounts, never a user promoting themself).
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // Inventory catalog. Read stays open (matches the original prototype);
    // writes now require an admin since real accounts/roles exist.
    match /assets/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // The asset request lifecycle document.
    match /assetRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.requesterId == request.auth.uid || isAdmin());

      // A requester may only create a request for themself, and it must
      // start at exactly the right initial status — closing off any
      // attempt to submit a request that's already "approved". A real,
      // registered admin must be named for both approval stages so the
      // request can actually move; those two ids are what the Level 1 /
      // Level 2 update rules below check against.
      allow create: if isSignedIn() &&
        request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.status == 'Pending Level 1 Approval' &&
        request.resource.data.immediateManagerId is string &&
        request.resource.data.immediateManagerId != '' &&
        request.resource.data.nextApprovingManagerId is string &&
        request.resource.data.nextApprovingManagerId != '';

      allow update: if isSignedIn() && (
        // Level 1 approval/rejection: only the specific admin named as
        // Immediate Manager on THIS request can act on it — not any admin.
        (
          resource.data.status == 'Pending Level 1 Approval' &&
          request.auth.uid == resource.data.immediateManagerId &&
          request.resource.data.status in ['Pending Level 2 Approval', 'Rejected']
        ) ||

        // Level 2 approval/rejection: only the specific admin named as
        // Next Approving Manager on THIS request can act on it.
        (
          resource.data.status == 'Pending Level 2 Approval' &&
          request.auth.uid == resource.data.nextApprovingManagerId &&
          request.resource.data.status in ['RID Raised', 'Rejected']
        ) ||

        // Every other stage (RID assignment, stock, FAT, officer sign-off,
        // closing) stays open to any admin, same as before — explicitly
        // excluding the two pending-approval statuses above so a random
        // admin can't reach around the designated-approver checks.
        (
          isAdmin() &&
          resource.data.status != 'Pending Level 1 Approval' &&
          resource.data.status != 'Pending Level 2 Approval'
        ) ||

        // The owning requester's own sign-off — unchanged from before.
        (
          resource.data.requesterId == request.auth.uid &&
          resource.data.status == 'Awaiting User Sign-Off' &&
          request.resource.data.status == 'Awaiting Approving Officer Sign-Off' &&
          request.resource.data.requesterId == resource.data.requesterId &&
          request.resource.data.rid == resource.data.rid &&
          request.resource.data.quantity == resource.data.quantity
        )
      );

      allow delete: if isAdmin();
    }
  }
}
