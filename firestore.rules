rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Inventory catalog. Still open for read/write since the app has no
    // login for regular browsing/editing (matches the original prototype).
    // Before deploying anywhere public, restrict writes to signed-in users,
    // e.g.: allow write: if request.auth != null;
    match /assets/{assetId} {
      allow read, write: if true;
    }

    // Allowlist of approver emails for the asset-request workflow. A doc
    // existing at approvers/{email} means that email can approve/reject
    // requests. Managed directly in the Firebase console/CLI — never
    // writable from a client.
    match /approvers/{approverId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Asset requests created by the Google Form -> Apps Script workflow.
    // Apps Script writes these via a service account using the Firestore
    // REST API, which authenticates through Google Cloud IAM and bypasses
    // these rules entirely (the same way the Admin SDK does) — so `create`
    // is blocked here to stop anyone from forging a request straight from
    // the browser. Only a signed-in approver can update (approve/reject) one.
    match /assetRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if false;
      allow update: if request.auth != null &&
        exists(/databases/$(database)/documents/approvers/$(request.auth.token.email));
      allow delete: if false;
    }
  }
}
