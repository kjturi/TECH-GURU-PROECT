rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Any of the three staff roles — the ones that get into the /admin
    // shell at all. Mirrors STAFF_ROLES in src/data/adminPermissions.js.
    function isStaff() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'technician_admin', 'inventory_admin'];
    }

    // Sub-permission within a staff role (see src/data/adminPermissions.js).
    // An admin doc with NO "permissions" field at all — every admin account
    // created before this feature existed — is grandfathered in as having
    // every permission, so introducing this can't lock out an admin who
    // relied on unconditional access before today. A newly promoted admin,
    // and every Technician Admin / Inventory Admin account (both brand new
    // roles — there's no legacy version of either), gets an explicit
    // permissions array instead, and is held to exactly what's listed there,
    // even if it's empty.
    function hasPermission(perm) {
      return isStaff() && (
        (isAdmin() && !('permissions' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)) ||
        (
          ('permissions' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
          perm in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions
        )
      );
    }

    // True if `field` holds the same value before and after this write (a
    // field missing on both sides counts as unchanged too). Used to pin
    // down ownership/content fields on assetRequests so a status update can
    // never smuggle in a change to who a request belongs to or what it's
    // for.
    function fieldUnchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // --- Job roles & role packages (mirrors src/data/jobRoles.js) -------
    // A person's job role lives on users/{uid}.jobRole, and the package for
    // that role at packages/{jobRole}. Keep these key lists in sync with
    // JOB_ROLES and PACKAGE_PERMISSIONS in jobRoles.js.
    function isJobRole(key) {
      return key in ['officer', 'senior_officer', 'team_leader', 'manager', 'senior_manager', 'hod', 'group_head'];
    }

    // True only if `uid` has a job role AND that role's package exists AND
    // grants `perm`. No role, or no package configured, means no access.
    function packageGrants(uid, perm) {
      let profilePath = /databases/$(database)/documents/users/$(uid);
      let role = exists(profilePath) ? get(profilePath).data.get('jobRole', null) : null;
      return role is string &&
        exists(/databases/$(database)/documents/packages/$(role)) &&
        perm in get(/databases/$(database)/documents/packages/$(role)).data.get('permissions', []);
    }

    // The pre-packages approver: an Admin account with approve_requests (or
    // a grandfathered admin with no permissions field at all).
    function adminCanApprove(uid) {
      let profilePath = /databases/$(database)/documents/users/$(uid);
      return exists(profilePath) &&
        get(profilePath).data.role == 'admin' &&
        (!('permissions' in get(profilePath).data) || 'approve_requests' in get(profilePath).data.permissions);
    }

    function canBeApprover(uid) {
      return packageGrants(uid, 'approve_requests') || adminCanApprove(uid);
    }

    // Job assignment fields on a profile. Only a "manage_users" admin may
    // change them, and never on their own profile.
    function jobAssignmentUnchanged() {
      return fieldUnchanged('jobRole') && fieldUnchanged('packageId') &&
        fieldUnchanged('buId') && fieldUnchanged('teamId');
    }

    // The package always follows the role: packageId must equal jobRole.
    function validJobAssignment() {
      let role = request.resource.data.get('jobRole', null);
      return request.resource.data.get('packageId', null) == role &&
        (role == null || isJobRole(role));
    }

    // User profiles: users/{uid}
    match /users/{userId} {
      // Anyone signed in can see a doc if it's their own, if they're an
      // admin, if they can provision Technician Admins (Inventory Admin
      // needs the full users list to do that from User Management), OR if
      // the doc itself is an admin's — that last clause is what lets the
      // Asset Request Form list admins to pick as Level 1 / Level 2
      // approvers, without exposing every requester's profile to every
      // other signed-in user.
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        hasPermission('provision_technicians') ||
        resource.data.role == 'admin'
      );

      // Registration: a user may only create THEIR OWN profile document,
      // and it must be created with role "requester". This — not anything
      // in the UI — is the real enforcement behind "a normal user must
      // never be able to assign themselves an elevated role": even a
      // hand-crafted request straight to Firestore is rejected if it tries
      // role: "admin" (or "technician_admin"/"inventory_admin") on create.
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'requester' &&
        !('jobRole' in request.resource.data) &&
        !('packageId' in request.resource.data) &&
        !('buId' in request.resource.data) &&
        !('teamId' in request.resource.data);

      // A user can update their own profile, but not their own role or
      // permissions — changing either requires "manage_users" (full user
      // management) or, narrowly, "provision_technicians". Nobody can grant
      // themself access this way: the self-update branch below requires
      // role/permissions to stay exactly as they were.
      allow update: if isSignedIn() && (
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.get('permissions', null) == resource.data.get('permissions', null) &&
          jobAssignmentUnchanged()
        ) ||
        // Full user management — including job role/package/team, which
        // must stay consistent (validJobAssignment) and can never be
        // changed on the admin's own profile.
        (
          hasPermission('manage_users') &&
          validJobAssignment() &&
          (request.auth.uid != userId || jobAssignmentUnchanged())
        ) ||
        // Inventory Admin's scoped provisioning right: may flip a user
        // between "requester" and "technician_admin" ONLY (an existing
        // admin/inventory_admin account is untouchable this way), and when
        // landing on technician_admin the permissions written must be
        // exactly the fixed bundle for that role — never a hand-picked or
        // elevated set. Mirrors ROLE_DEFAULT_PERMISSIONS.technician_admin
        // in src/data/adminPermissions.js — keep both in sync.
        (
          hasPermission('provision_technicians') &&
          request.auth.uid != userId &&
          jobAssignmentUnchanged() &&
          resource.data.role in ['requester', 'technician_admin'] &&
          request.resource.data.role in ['requester', 'technician_admin'] &&
          (
            (
              request.resource.data.role == 'technician_admin' &&
              request.resource.data.permissions == ['manage_assets', 'manage_sims', 'manage_requests']
            ) ||
            request.resource.data.role == 'requester'
          )
        )
      );

      allow delete: if hasPermission('manage_users');
    }

    // Inventory catalog (generic quantity-based stock). Kept in place for
    // rollback/history even though Stock/Inventory no longer routes to it —
    // see devices/purchaseOrders/simCards below, which replaced it as the
    // live inventory model. Same open-read/admin-write posture as before.
    match /assets/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Serialized device inventory (CUG mobiles, headsets, desk phones, WiFi
    // modems) — ported from GDPCapstone's per-type MySQL tables into one
    // collection distinguished by `type`. Read is staff-only: a unit carries
    // assignedToRequestId, so open reads would let anyone map serial numbers
    // to other people's requests. Requesters see their own issued assets
    // through assetRequests.assetInfo (owner-scoped) instead. Write is also
    // open to "manage_assets" (Technician Admin's core job).
    match /devices/{deviceId} {
      allow read: if isStaff();
      allow write: if isAdmin() || hasPermission('manage_assets');
    }

    // PO Number -> Invoice Number pairs (ported from GDPCapstone's
    // `orderform` table). The "one invoice per PO" rule itself is enforced
    // in the client transaction in useDevices.js, not here — same trust
    // boundary as the rest of a manage_assets-gated write.
    match /purchaseOrders/{poNumber} {
      allow read: if isStaff();
      allow write: if isAdmin() || hasPermission('manage_assets');
    }

    // CUG SIM cards (ported from GDPCapstone's `cugsimcards` table),
    // optionally linked to a `devices` doc by IMEI. Both Technician Admin
    // and Inventory Admin hold "manage_sims".
    match /simCards/{spid} {
      allow read: if isStaff();
      allow write: if isAdmin() || hasPermission('manage_sims');
    }

    // Role packages: one per job role, id == role key. Anyone signed in can
    // read them (the UI needs to know what their own package allows). Only
    // "manage_users" admins may edit, and never the package for their own
    // job role — nobody can widen their own access.
    match /packages/{roleKey} {
      allow read: if isSignedIn();
      allow create, update: if hasPermission('manage_users') &&
        isJobRole(roleKey) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('jobRole', null) != roleKey &&
        request.resource.data.keys().hasOnly(['name', 'permissions', 'updatedAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.permissions is list &&
        request.resource.data.permissions.hasOnly(['submit_requests', 'approve_requests']);
      allow delete: if hasPermission('manage_users') &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('jobRole', null) != roleKey;
    }

    // Minimal public card (name, job role, BU, team) for everyone with a
    // job role — what the request form reads to find approvers, instead of
    // exposing full profiles. Written only alongside the matching users doc
    // (checked with getAfter), so it can't drift from the real assignment.
    match /directory/{uid} {
      allow read: if isSignedIn();
      allow create, update: if hasPermission('manage_users') &&
        request.auth.uid != uid &&
        request.resource.data.keys().hasOnly(['name', 'jobRole', 'buId', 'teamId']) &&
        request.resource.data.jobRole == getAfter(/databases/$(database)/documents/users/$(uid)).data.get('jobRole', null) &&
        request.resource.data.buId == getAfter(/databases/$(database)/documents/users/$(uid)).data.get('buId', null) &&
        request.resource.data.teamId == getAfter(/databases/$(database)/documents/users/$(uid)).data.get('teamId', null);
      allow delete: if hasPermission('manage_users') && request.auth.uid != uid;
    }

    // Org structure used for approver routing.
    match /businessUnits/{buId} {
      allow read: if isSignedIn();
      allow write: if hasPermission('manage_users');
    }
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create, update: if hasPermission('manage_users') && request.resource.data.buId is string;
      allow delete: if hasPermission('manage_users');
    }

    // The asset request lifecycle document.
    match /assetRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.immediateManagerId == request.auth.uid ||
        resource.data.nextApprovingManagerId == request.auth.uid ||
        isAdmin() || hasPermission('manage_requests')
      );

      // A requester may only create a request for themself, and it must
      // start at exactly the right initial status — closing off any
      // attempt to submit a request that's already "approved". A real,
      // registered admin must be named for both approval stages so the
      // request can actually move; those two ids are what the Level 1 /
      // Level 2 update rules below check against. The declaration ("I have
      // read... and agree to abide by the terms and conditions", shown as a
      // required checkbox on the request form) is enforced here too — the
      // UI already refuses to submit without it, but until now nothing
      // stopped a direct write to the API from skipping it.
      allow create: if isSignedIn() &&
        request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.status == 'Pending Level 1 Approval' &&
        request.resource.data.immediateManagerId is string &&
        request.resource.data.immediateManagerId != '' &&
        request.resource.data.nextApprovingManagerId is string &&
        request.resource.data.nextApprovingManagerId != '' &&
        request.resource.data.declarationAccepted == true &&
        request.resource.data.declarationAcceptedAt != null &&
        // Package: the requester's role must allow requesting.
        packageGrants(request.auth.uid, 'submit_requests') &&
        // Approvers are suggested from the team but can be changed — so
        // whoever is named must actually be allowed to approve, be two
        // different people, and not be the requester.
        request.resource.data.immediateManagerId != request.resource.data.nextApprovingManagerId &&
        request.resource.data.immediateManagerId != request.auth.uid &&
        request.resource.data.nextApprovingManagerId != request.auth.uid &&
        canBeApprover(request.resource.data.immediateManagerId) &&
        canBeApprover(request.resource.data.nextApprovingManagerId);

      // Ownership and request content can never change as a side effect of
      // a status update, by anyone, at any stage — only the fields each
      // workflow action actually needs to touch (status, rid, and the
      // stage-specific detail object) are left out of this list.
      allow update: if isSignedIn() &&
        fieldUnchanged('requesterId') && fieldUnchanged('requesterName') && fieldUnchanged('requesterEmail') &&
        fieldUnchanged('employeeId') && fieldUnchanged('department') &&
        fieldUnchanged('assetType') && fieldUnchanged('description') && fieldUnchanged('quantity') &&
        fieldUnchanged('justification') && fieldUnchanged('priority') && fieldUnchanged('dateRequired') &&
        fieldUnchanged('immediateManagerId') && fieldUnchanged('nextApprovingManagerId') &&
        fieldUnchanged('createdAt') &&
        (
          // Level 1 approval/rejection: only the specific admin named as
          // Immediate Manager on THIS request, and only while they currently
          // hold "approve_requests" — being named isn't enough on its own if
          // that permission was revoked after the request was submitted.
          (
            resource.data.status == 'Pending Level 1 Approval' &&
            request.auth.uid == resource.data.immediateManagerId &&
            (hasPermission('approve_requests') || packageGrants(request.auth.uid, 'approve_requests')) &&
            request.resource.data.status in ['Pending Level 2 Approval', 'Rejected'] &&
            fieldUnchanged('rid')
          ) ||

          // Level 2 approval/rejection: only the specific admin named as
          // Next Approving Manager on THIS request. This is the one place
          // `rid` is allowed to change — from null to the newly-raised id.
          (
            resource.data.status == 'Pending Level 2 Approval' &&
            request.auth.uid == resource.data.nextApprovingManagerId &&
            (hasPermission('approve_requests') || packageGrants(request.auth.uid, 'approve_requests')) &&
            request.resource.data.status in ['RID Raised', 'Rejected']
          ) ||

          // Every other stage (RID assignment, stock, FAT, officer sign-off,
          // closing) stays open to any admin OR "manage_requests" holder
          // (Technician Admin, Inventory Admin) — explicitly excluding the
          // two pending-approval statuses above so nobody can reach around
          // the designated-approver checks.
          (
            (isAdmin() || hasPermission('manage_requests')) &&
            resource.data.status != 'Pending Level 1 Approval' &&
            resource.data.status != 'Pending Level 2 Approval' &&
            fieldUnchanged('rid')
          ) ||

          // The owning requester's own sign-off — unchanged from before.
          (
            resource.data.requesterId == request.auth.uid &&
            resource.data.status == 'Awaiting User Sign-Off' &&
            request.resource.data.status == 'Awaiting Approving Officer Sign-Off' &&
            request.resource.data.requesterId == resource.data.requesterId &&
            request.resource.data.rid == resource.data.rid &&
            request.resource.data.quantity == resource.data.quantity &&
            fieldUnchanged('rid')
          )
        );

      allow delete: if isAdmin();
    }
  }
}
